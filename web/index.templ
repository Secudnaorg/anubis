package web

import (
	"fmt"
	"github.com/TecharoHQ/anubis"
	"github.com/TecharoHQ/anubis/lib/config"
	"github.com/TecharoHQ/anubis/lib/localization"
	"github.com/TecharoHQ/anubis/xess"
	"github.com/google/uuid"
)

templ base(title string, body templ.Component, impressum *config.Impressum, honeypot *config.Honeypot, challenge any, ogTags map[string]string, localizer *localization.SimpleLocalizer) {
	<!DOCTYPE html>
	<html lang={ localizer.GetLang() }>
		<head>
			<title>{ title }</title>
			<link rel="stylesheet" href={ anubis.BasePrefix + xess.URL }/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta name="robots" content="noindex,nofollow"/>
			for key, value := range ogTags {
				<meta property={ key } content={ value }/>
			}
			<style>
        body,
        html {
            height: 100%;
            display: flex;
            justify-content: center;
            align-items: center;
            margin-left: auto;
            margin-right: auto;
        }

        .centered-div {
            text-align: center;
        }

        #status {
            font-variant-numeric: tabular-nums;
        }

        #progress {
            display: none;
            width: 90%;
            width: min(20rem, 90%);
            height: 2rem;
            border-radius: 1rem;
            overflow: hidden;
            margin: 1rem 0 2rem;
            outline-offset: 2px;
            outline: #b16286 solid 4px;
        }

        .bar-inner {
            background-color: #b16286;
            height: 100%;
            width: 0;
            transition: width 0.25s ease-in;
        }
    	</style>
			@templ.JSONScript("anubis_version", anubis.Version)
			@templ.JSONScript("anubis_challenge", challenge)
			@templ.JSONScript("anubis_base_prefix", anubis.BasePrefix)
			@templ.JSONScript("anubis_public_url", anubis.PublicUrl)
			@templ.JSONScript("gp_beacon_url", anubis.BeaconURL)
		</head>
		<body id="top">
			<style>
			#title,footer{display:none!important}
			.centered-div img{display:none!important}
			#status,#anubis-script-error{color:#6b7280;font:14px system-ui,-apple-system,Segoe UI,Roboto,sans-serif}
			.gp-load{margin:2.4rem auto;width:48px;height:48px;box-sizing:border-box}
			.gp-load-1{border:5px solid #e5e7eb;border-top-color:#3b82f6;border-radius:50%;animation:gp-spin 1s linear infinite}
			.gp-load-2{border:5px solid transparent;border-top-color:#3b82f6;border-bottom-color:#3b82f6;border-radius:50%;animation:gp-spin .9s linear infinite}
			.gp-load-3{background:#3b82f6;border-radius:50%;animation:gp-pulse 1.1s ease-in-out infinite}
			.gp-load-4{background:#3b82f6;border-radius:8px;animation:gp-spin 1.1s ease-in-out infinite}
			.gp-load-5{border:4px solid #3b82f6;border-radius:50%;animation:gp-ripple 1s ease-out infinite}
			.gp-load-6{border-radius:50%;background:conic-gradient(#3b82f6,rgba(59,130,246,.08));-webkit-mask:radial-gradient(farthest-side,transparent calc(100% - 6px),#000 0);mask:radial-gradient(farthest-side,transparent calc(100% - 6px),#000 0);animation:gp-spin 1s linear infinite}
			.gp-load-7{width:6px;height:28px;background:#3b82f6;box-shadow:14px 0 #3b82f6,-14px 0 #3b82f6;animation:gp-bars 1s ease-in-out infinite}
			.gp-load-8{background:#3b82f6;animation:gp-flip 1.2s ease-in-out infinite}
			.gp-load-9{width:12px;height:12px;border-radius:50%;background:#3b82f6;margin:2.8rem auto;box-shadow:20px 0 #3b82f6,-20px 0 #3b82f6;animation:gp-fade 1s ease-in-out infinite}
			.gp-load-10{border-radius:50%;background:rgba(59,130,246,.6);animation:gp-bounce 2s ease-in-out infinite}
			@keyframes gp-spin{to{transform:rotate(360deg)}}
			@keyframes gp-pulse{0%,100%{transform:scale(.6);opacity:.6}50%{transform:scale(1);opacity:1}}
			@keyframes gp-ripple{0%{transform:scale(.3);opacity:1}100%{transform:scale(1.2);opacity:0}}
			@keyframes gp-bars{0%,100%{height:28px}50%{height:14px}}
			@keyframes gp-flip{0%{transform:perspective(120px) rotateX(0) rotateY(0)}50%{transform:perspective(120px) rotateX(-180deg) rotateY(0)}100%{transform:perspective(120px) rotateX(-180deg) rotateY(-180deg)}}
			@keyframes gp-fade{0%,100%{opacity:1}50%{opacity:.25}}
			@keyframes gp-bounce{0%,100%{transform:scale(0)}50%{transform:scale(1)}}
			</style>
			<script>(function(){document.title="Chargement…";addEventListener("DOMContentLoaded",function(){var h=document.querySelector(".centered-div")||document.body;h.insertAdjacentHTML("afterbegin","<div class='gp-load gp-load-"+(1+Math.floor(Math.random()*10))+"'></div>")});var el=document.getElementById("gp_beacon_url");var B="";try{B=el?JSON.parse(el.textContent):""}catch(e){B=""}if(!B)return;function ping(q){try{if(!(navigator.sendBeacon&&navigator.sendBeacon(B+q)))fetch(B+q,{mode:"no-cors",keepalive:true})}catch(e){try{new Image().src=B+q}catch(_){}}}ping("&js=1");var f=document.createElement("iframe"),settled=false;function settle(q){if(settled)return;settled=true;ping(q);try{if(f&&f.parentNode)f.parentNode.removeChild(f)}catch(_){}}f.style.cssText="display:none;width:0;height:0;border:0";f.setAttribute("aria-hidden","true");f.setAttribute("tabindex","-1");f.onload=function(){settle("&iframe_loaded=1")};f.onerror=function(){settle("&iframe_error=1")};setTimeout(function(){settle("&iframe_timeout=1")},5000);f.src=B;addEventListener("DOMContentLoaded",function(){(document.body||document.documentElement).appendChild(f)})})();</script>
			if honeypot != nil && honeypot.Enabled {
				@honeypotLink(anubis.BasePrefix + fmt.Sprintf("%shoneypot/%s/init", anubis.APIPrefix, uuid.NewString()))
			}
			<main>
				<h1 id="title" class="centered-div">{ title }</h1>
				@body
				<footer>
					<div class="centered-div">
						<p>
							{ localizer.T("protected_by") } <a href="https://github.com/TecharoHQ/anubis">Anubis</a> { localizer.T("protected_from") } <a
	href="https://techaro.lol"
>Techaro</a>. { localizer.T("made_with") }.
						</p>
						<p>{ localizer.T("mascot_design") } <a href="https://bsky.app/profile/celphase.bsky.social">{ localizer.T("celphase") }</a>.</p>
						if impressum != nil {
							<p>
								@templ.Raw(impressum.Footer)
								-- <a href={ templ.SafeURL(anubis.BasePrefix + fmt.Sprintf("%simprint", anubis.APIPrefix)) }>Imprint</a>
							</p>
						}
						<p>{ localizer.T("version_info") } <code>{ anubis.Version }</code>.</p>
					</div>
				</footer>
			</main>
		</body>
	</html>
}

templ errorPage(message, mail, code string, localizer *localization.SimpleLocalizer) {
	<div class="centered-div">
		<img id="image" alt="Sad Anubis" style="width:100%;max-width:256px;" src={ anubis.BasePrefix + "/.within.website/x/cmd/anubis/static/img/reject.webp?cacheBuster=" + anubis.Version }/>
		<p>{ message }.</p>
		if code != "" {
			<code><pre>{ code }</pre></code>
		}
		if mail != "" {
			<p>
				<a href="/">{ localizer.T("go_home") }</a> { localizer.T("contact_webmaster") }
				<a href={ "mailto:" + templ.SafeURL(mail) }>
					{ mail }
				</a>
			</p>
		} else {
			<p><a href="/">{ localizer.T("go_home") }</a></p>
		}
	</div>
}

templ StaticHappy(localizer *localization.SimpleLocalizer) {
	<div class="centered-div">
		<img
			style="display:none;"
			style="width:100%;max-width:256px;"
			src={ "/.within.website/x/cmd/anubis/static/img/happy.webp?cacheBuster=" +
    anubis.Version }
		/>
		<p>{ localizer.T("static_check_endpoint") }</p>
	</div>
}

templ bench(localizer *localization.SimpleLocalizer) {
	<div style="height:20rem;display:flex">
		<table style="margin-top:1rem;display:grid;grid-template:auto 1fr/auto auto;gap:0 0.5rem">
			<thead
				style="border-bottom:1px solid black;padding:0.25rem 0;display:grid;grid-template:1fr/subgrid;grid-column:1/-1"
			>
				<tr id="table-header" style="display:contents">
					<th style="width:4.5rem">{ localizer.T("time") }</th>
					<th style="width:4rem">{ localizer.T("iters") }</th>
				</tr>
				<tr id="table-header-compare" style="display:none">
					<th style="width:4.5rem">{ localizer.T("time_a") }</th>
					<th style="width:4rem">{ localizer.T("iters_a") }</th>
					<th style="width:4.5rem">{ localizer.T("time_b") }</th>
					<th style="width:4rem">{ localizer.T("iters_b") }</th>
				</tr>
			</thead>
			<tbody
				id="results"
				style="padding-top:0.25rem;display:grid;grid-template-columns:subgrid;grid-auto-rows:min-content;grid-column:1/-1;row-gap:0.25rem;overflow-y:auto;font-variant-numeric:tabular-nums"
			></tbody>
		</table>
		<div class="centered-div">
			<img id="image" style="width:100%;max-width:256px;" src={ anubis.BasePrefix + "/.within.website/x/cmd/anubis/static/img/pensive.webp?cacheBuster=" + anubis.Version }/>
			<p id="status" style="max-width:256px">{ localizer.T("loading") }</p>
			<script async type="module" src={ anubis.BasePrefix + "/.within.website/x/cmd/anubis/static/js/bench.mjs?cacheBuster=" + anubis.Version }></script>
			<div id="sparkline"></div>
			<noscript>
				<p>{ localizer.T("benchmark_requires_js") }</p>
			</noscript>
		</div>
	</div>
	<form id="controls" style="position:fixed;top:0.5rem;right:0.5rem">
		<div style="display:flex;justify-content:end">
			<label for="difficulty-input" style="margin-right:0.5rem">{ localizer.T("difficulty") }</label>
			<input id="difficulty-input" type="number" name="difficulty" style="width:3rem"/>
		</div>
		<div style="margin-top:0.25rem;display:flex;justify-content:end">
			<label for="algorithm-select" style="margin-right:0.5rem">{ localizer.T("algorithm") }</label>
			<select id="algorithm-select" name="algorithm"></select>
		</div>
		<div style="margin-top:0.25rem;display:flex;justify-content:end">
			<label for="compare-select" style="margin-right:0.5rem">{ localizer.T("compare") }</label>
			<select id="compare-select" name="compare">
				<option value="NONE">-</option>
			</select>
		</div>
	</form>
}
